{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parts catalog",
  "description": "parts/catalog.yaml: every part, material and tool projects can use.",
  "type": "object",
  "propertyNames": { "pattern": "^[a-z0-9-]+$" },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["category", "name"],
    "properties": {
      "category": { "enum": ["component", "board", "material", "tool"] },
      "kind": { "enum": ["resistor", "led", "buzzer", "terminal", "transistor", "ldr", "elko", "cap", "button", "jumper", "toroid", "leads", "dip8", "dip16"], "description": "How it is drawn on the perfboard." },
      "chip": { "type": "string", "description": "Text printed on a chip (dip kinds)." },
      "leads": {
        "type": "object",
        "additionalProperties": false,
        "description": "For kind leads: wires that leave the board.",
        "properties": {
          "pins": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
          "colors": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
          "tag": { "type": "string" },
          "labels": { "type": "object", "additionalProperties": false, "required": ["de", "en"], "properties": { "de": { "type": "array", "items": { "type": "string" } }, "en": { "type": "array", "items": { "type": "string" } } } }
        }
      },
      "icon": { "type": "string", "description": "Emoji for parts that are not drawn." },
      "name": { "$ref": "#/$defs/i18n" },
      "hint": { "$ref": "#/$defs/i18n" }
    },
    "oneOf": [{ "required": ["kind"] }, { "required": ["icon"] }]
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["de", "en"],
      "properties": { "de": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    }
  }
}
